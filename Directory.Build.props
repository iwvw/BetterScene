<Project>

  <PropertyGroup>
    <VersionPrefix>0.2.0</VersionPrefix>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <Product>BetterScene</Product>
    <Authors>DSUK</Authors>
    <Company>DSUK</Company>
    <Copyright>Copyright © 2026 DSUK</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/iwvw/BetterScene</RepositoryUrl>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
