<Window
    x:Class="BetterScene.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="Windows 视觉改善">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Image x:Name="BrandIcon"
                       Width="20"
                       Height="20"
                       Source="ms-appx:///Assets/AppIcon.png" />
                <TextBlock x:Name="TitleText" Text="Windows 视觉改善" FontWeight="SemiBold" />

                <!-- 版本号：低对比度小药丸，不抢标题的视觉重量。 -->
                <Border VerticalAlignment="Center"
                        Padding="7,2"
                        CornerRadius="4"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <TextBlock x:Name="AppVersionText"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="v-" />
                </Border>

                <!-- 有更新时才出现。点击直接下载安装并重启。 -->
                <Button x:Name="UpdateButton"
                        Visibility="Collapsed"
                        Click="OnUpdateBadgeClick"
                        Padding="10,3"
                        CornerRadius="4"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        BorderThickness="0"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="发现新版本，点击下载并更新">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="13" Glyph="&#xE895;" />
                        <TextBlock x:Name="UpdateButtonText"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="有新版本" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <muxc:NavigationView Grid.Row="1"
                             x:Name="NavView"
                             Background="Transparent"
                             IsSettingsVisible="True"
                             IsBackButtonVisible="Collapsed"
                             PaneDisplayMode="Left"
                             OpenPaneLength="200"
                             IsPaneToggleButtonVisible="True">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="概览" Tag="overview">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="场景" Tag="scenes">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE793;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="自动切换" Tag="auto">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="显示器" Tag="displays">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="输入" Tag="input">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <Frame x:Name="NavFrame">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition>
                            <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                <EntranceNavigationTransitionInfo />
                            </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                        </NavigationThemeTransition>
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </muxc:NavigationView>
    </Grid>
</Window>
