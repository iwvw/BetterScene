<Window
    x:Class="BetterScene.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="Windows 视觉改善">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Image x:Name="BrandIcon"
                       Width="20"
                       Height="20"
                       Source="ms-appx:///Assets/AppIcon.png" />
                <TextBlock x:Name="TitleText" Text="Windows 视觉改善" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <muxc:NavigationView Grid.Row="1"
                             x:Name="NavView"
                             Background="Transparent"
                             IsSettingsVisible="True"
                             IsBackButtonVisible="Collapsed"
                             PaneDisplayMode="Left"
                             OpenPaneLength="200"
                             IsPaneToggleButtonVisible="True">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="概览" Tag="overview">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="场景" Tag="scenes">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE793;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="自动切换" Tag="auto">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="显示器" Tag="displays">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="输入" Tag="input">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <Frame x:Name="NavFrame">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition>
                            <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                <EntranceNavigationTransitionInfo />
                            </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                        </NavigationThemeTransition>
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </muxc:NavigationView>
    </Grid>
</Window>
