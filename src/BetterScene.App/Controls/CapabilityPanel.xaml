<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BetterScene.App.Controls.CapabilityPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BetterScene.App.Controls">

    <Grid MinWidth="580" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 概要 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="SummaryText"
                       Style="{StaticResource BodyTextBlockStyle}"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="ErrorText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      MaxHeight="440"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="6">

                <!-- 可调控制项 -->
                <TextBlock x:Name="ControlsHeader"
                           Text="可调控制"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="0,4,0,0"
                           Visibility="Collapsed" />

                <ItemsControl x:Name="ControlList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="controls:ControlRow">
                            <Grid Padding="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Name, Mode=OneWay}"
                                           VerticalAlignment="Center" />

                                <!-- 连续型：滑块 -->
                                <Slider Grid.Column="1"
                                        Minimum="{x:Bind Minimum, Mode=OneWay}"
                                        Maximum="{x:Bind Maximum, Mode=OneWay}"
                                        Value="{x:Bind Value, Mode=TwoWay}"
                                        StepFrequency="1"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind SliderVisibility, Mode=OneWay}" />

                                <!-- 离散型：下拉框 -->
                                <ComboBox Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind Choices}"
                                          SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}"
                                          DisplayMemberPath="Label"
                                          Visibility="{x:Bind ChoiceVisibility, Mode=OneWay}" />

                                <!-- 动作型：按钮组 -->
                                <ItemsControl Grid.Column="1"
                                              ItemsSource="{x:Bind Choices}"
                                              Visibility="{x:Bind ActionVisibility, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="controls:ChoiceRow">
                                            <Button Content="{x:Bind Label, Mode=OneWay}"
                                                    Click="{x:Bind OnClick}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind ValueText, Mode=OneWay}"
                                           MinWidth="64"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 原始能力清单 -->
                <TextBlock x:Name="RawHeader"
                           Text="全部能力项"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="0,12,0,0" />

                <ItemsControl x:Name="CapabilityList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="controls:CapabilityRow">
                            <Grid Padding="0,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind CodeText, Mode=OneWay}"
                                           FontFamily="Consolas"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{x:Bind DetailVisibility, Mode=OneWay}" />
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind RangeText, Mode=OneWay}"
                                           VerticalAlignment="Top"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   x:Name="FooterText"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
