<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>BetterScene</AssemblyName>
    <RootNamespace>BetterScene.App</RootNamespace>
    <AssemblyTitle>Windows 视觉改善</AssemblyTitle>
    <Product>Windows 视觉改善</Product>
    <Description>Windows 视觉改善 - 场景化的明暗与亮度管理</Description>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)' == ''">true</WindowsAppSDKSelfContained>
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <EnableMsixTooling>false</EnableMsixTooling>

    <!--
      WinUI 3 必须有 .pri 资源包才能加载 XAML 资源字典（XamlControlsResources 等）。
      dotnet publish 默认不跑 PRI 生成目标，产物里缺 .pri，程序一启动就崩在
      Microsoft.UI.Xaml.dll（0xC000027B）。这两个开关强制 publish 也生成 PRI。
    -->
    <EnableDefaultPriItems Condition="'$(EnableDefaultPriItems)' == ''">true</EnableDefaultPriItems>
    <GeneratePriFile>true</GeneratePriFile>
    <ShouldComputeInputPris>true</ShouldComputeInputPris>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.5.0-beta.3" />
    <PackageReference Include="WinUIEx" Version="2.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BetterScene.Core\BetterScene.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\TrayWhite.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\TrayBlack.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\BrandLight.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\BrandDark.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <Target Name="BuildDisplaysWorker" BeforeTargets="Build">
    <MSBuild Projects="..\BetterScene.Displays\BetterScene.Displays.csproj"
             Targets="Restore;Build;GetTargetPath"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" ItemName="DisplaysWorkerOutputs" />
    </MSBuild>
  </Target>

  <Target Name="CopyDisplaysWorker" AfterTargets="Build" DependsOnTargets="BuildDisplaysWorker">
    <PropertyGroup>
      <_DisplaysWorkerDir>%(DisplaysWorkerOutputs.RootDir)%(DisplaysWorkerOutputs.Directory)</_DisplaysWorkerDir>
    </PropertyGroup>
    <ItemGroup>
      <DisplaysWorkerFiles Include="$(_DisplaysWorkerDir)*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(DisplaysWorkerFiles)"
          DestinationFiles="@(DisplaysWorkerFiles->'$(OutDir)worker\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    publish 不走 Build 的 AfterTargets，必须单独挂一次，
    否则安装包/便携包里完全没有 worker\ 目录，程序启动即崩（0xC000027B）。
  -->
  <Target Name="PublishDisplaysWorker" AfterTargets="Publish" DependsOnTargets="BuildDisplaysWorker">
    <PropertyGroup>
      <_DisplaysWorkerDir>%(DisplaysWorkerOutputs.RootDir)%(DisplaysWorkerOutputs.Directory)</_DisplaysWorkerDir>
      <_DisplaysWorkerPublishDir>$(PublishDir)worker\</_DisplaysWorkerPublishDir>
    </PropertyGroup>
    <ItemGroup>
      <DisplaysWorkerPublishFiles Include="$(_DisplaysWorkerDir)*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(DisplaysWorkerPublishFiles)"
          DestinationFiles="@(DisplaysWorkerPublishFiles->'$(_DisplaysWorkerPublishDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    WinUI 3 必须有 .pri 才能加载 XAML 资源字典。
    PRI 只在 Build 阶段生成，publish 不会带上它，产物里缺 .pri 会导致
    程序启动即崩在 Microsoft.UI.Xaml.dll（0xC000027B）——表现为"双击没反应"。
    这里显式把 Build 产出的 .pri 复制进发布目录。
  -->
  <Target Name="PublishPriFile" AfterTargets="Publish" DependsOnTargets="Build">
    <ItemGroup>
      <_PriFiles Include="$(OutDir)*.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_PriFiles)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_PriFiles)' != ''" />
  </Target>
</Project>
