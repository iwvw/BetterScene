<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>BetterScene</AssemblyName>
    <RootNamespace>BetterScene.App</RootNamespace>
    <AssemblyTitle>Windows 视觉改善</AssemblyTitle>
    <Product>Windows 视觉改善</Product>
    <Description>Windows 视觉改善 - 场景化的明暗与亮度管理</Description>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)' == ''">true</WindowsAppSDKSelfContained>
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.5.0-beta.3" />
    <PackageReference Include="WinUIEx" Version="2.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BetterScene.Core\BetterScene.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\TrayWhite.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\TrayBlack.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\BrandLight.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\BrandDark.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <Target Name="BuildDisplaysWorker" BeforeTargets="Build">
    <MSBuild Projects="..\BetterScene.Displays\BetterScene.Displays.csproj"
             Targets="Restore;Build;GetTargetPath"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" ItemName="DisplaysWorkerOutputs" />
    </MSBuild>
  </Target>

  <Target Name="CopyDisplaysWorker" AfterTargets="Build" DependsOnTargets="BuildDisplaysWorker">
    <PropertyGroup>
      <_DisplaysWorkerDir>%(DisplaysWorkerOutputs.RootDir)%(DisplaysWorkerOutputs.Directory)</_DisplaysWorkerDir>
    </PropertyGroup>
    <ItemGroup>
      <DisplaysWorkerFiles Include="$(_DisplaysWorkerDir)*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(DisplaysWorkerFiles)"
          DestinationFiles="@(DisplaysWorkerFiles->'$(OutDir)worker\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
