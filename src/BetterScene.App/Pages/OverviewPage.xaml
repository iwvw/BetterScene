<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BetterScene.App.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BetterScene.App.Controls"
    xmlns:services="using:BetterScene.App.Services"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    Style="{StaticResource PageRootStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="概览" />

        <ScrollViewer Grid.Row="1"
                      Padding="36,0,36,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      HorizontalContentAlignment="Stretch">
            <StackPanel Padding="0,0,0,24" Spacing="{StaticResource SettingsCardSpacing}" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="50" />
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <!-- 当前场景 -->
                <tk:SettingsExpander Header="当前场景">                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE793;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="明暗">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ToggleButton x:Name="LightButton"
                                              Content="浅色"
                                              MinWidth="80"
                                              Click="OnLightClick" />
                                <ToggleButton x:Name="DarkButton"
                                              Content="深色"
                                              MinWidth="80"
                                              Click="OnDarkClick" />
                            </StackPanel>
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="自动切换">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="AutoValue"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="AutoNextValue"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="壁纸">
                            <TextBlock x:Name="WallpaperValue"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <!-- 亮度 + 扩展控制（对比度/音量/色彩预设）
                     注意：SettingsExpander.Items 只接受 SettingsCard，
                     所以这里用普通 StackPanel 承载，卡片由代码生成。 -->
                <StackPanel x:Name="DisplayHost" Spacing="{StaticResource SettingsCardSpacing}" />

                <tk:SettingsCard x:Name="EmptyCard"
                                 Header="未检测到显示器"
                                 Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>





