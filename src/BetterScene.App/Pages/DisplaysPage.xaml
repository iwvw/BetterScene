<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BetterScene.App.Pages.DisplaysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BetterScene.App.Controls"
    xmlns:services="using:BetterScene.App.Services"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    Style="{StaticResource PageRootStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="显示器">
            <controls:PageHeader.Actions>
                <Button x:Name="RefreshButton" Content="重新检测" Click="OnRefreshClick" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <ScrollViewer Grid.Row="1"
                      Padding="36,0,36,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      HorizontalContentAlignment="Stretch">
            <StackPanel Padding="0,0,0,24" Spacing="{StaticResource SettingsCardSpacing}" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="50" />
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <InfoBar x:Name="InlineInfoBar"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Informational" />

                <ItemsControl x:Name="DisplayList">                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:DisplaySliderItem">
                            <tk:SettingsExpander Header="{x:Bind Title, Mode=OneWay}"
                                                 Description="{x:Bind HardwareSummary, Mode=OneWay}"
                                                 Margin="0,0,0,4">
                                <tk:SettingsExpander.Items>
                                    <tk:SettingsCard Header="品牌">
                                        <TextBlock Text="{x:Bind Brand, Mode=OneWay}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </tk:SettingsCard>

                                    <tk:SettingsCard Header="型号">
                                        <TextBlock Text="{x:Bind ModelName, Mode=OneWay}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </tk:SettingsCard>

                                    <tk:SettingsCard Header="控制方式">
                                        <TextBlock Text="{x:Bind BackendSummary, Mode=OneWay}"
                                                   TextAlignment="Right"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </tk:SettingsCard>

                                    <tk:SettingsCard Header="原始数据">
                                        <TextBlock Text="{x:Bind RawSummary, Mode=OneWay}"
                                                   TextAlignment="Right"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </tk:SettingsCard>

                                    <tk:SettingsCard Header="控制项探测">
                                        <Button Content="探测能力"
                                                Click="OnProbeCapabilities"
                                                Tag="{x:Bind Id}" />
                                    </tk:SettingsCard>

                                    <!-- HDR。不支持的显示器整行隐藏。 -->
                                    <tk:SettingsCard Header="HDR"
                                                     Description="{x:Bind HdrSummary, Mode=OneWay}"
                                                     Visibility="{x:Bind HdrVisibility, Mode=OneWay}">
                                        <ToggleSwitch IsOn="{x:Bind HdrEnabled, Mode=OneWay}"
                                                      IsEnabled="{x:Bind HdrToggleEnabled, Mode=OneWay}"
                                                      Toggled="OnHdrToggled"
                                                      Tag="{x:Bind Id}" />
                                    </tk:SettingsCard>

                                    <!-- 分辨率。切换后刷新率会尽量保留当前值。 -->
                                    <tk:SettingsCard Header="分辨率"
                                                     Visibility="{x:Bind ModeVisibility, Mode=OneWay}">
                                        <ComboBox ItemsSource="{x:Bind ResolutionLabels, Mode=OneWay}"
                                                  SelectedIndex="{x:Bind ResolutionIndex, Mode=OneWay}"
                                                  MinWidth="160"
                                                  SelectionChanged="OnResolutionChanged"
                                                  Tag="{x:Bind Id}" />
                                    </tk:SettingsCard>

                                    <!-- 刷新率。选项随分辨率变化。 -->
                                    <tk:SettingsCard Header="刷新率"
                                                     Visibility="{x:Bind ModeVisibility, Mode=OneWay}">
                                        <ComboBox ItemsSource="{x:Bind RefreshRateLabels, Mode=OneWay}"
                                                  SelectedIndex="{x:Bind RefreshRateIndex, Mode=OneWay}"
                                                  MinWidth="160"
                                                  SelectionChanged="OnRefreshRateChanged"
                                                  Tag="{x:Bind Id}" />
                                    </tk:SettingsCard>

                                    <!-- 缩放。写注册表，需要重新登录才生效。 -->
                                    <tk:SettingsCard Header="缩放"
                                                     Description="修改后需要重新登录 Windows 才会完全生效。"
                                                     Visibility="{x:Bind ScaleVisibility, Mode=OneWay}">
                                        <ComboBox ItemsSource="{x:Bind ScaleLabels, Mode=OneWay}"
                                                  SelectedIndex="{x:Bind ScaleIndex, Mode=OneWay}"
                                                  MinWidth="160"
                                                  SelectionChanged="OnScaleChanged"
                                                  Tag="{x:Bind Id}" />
                                    </tk:SettingsCard>

                                    <!-- 这台显示器在迷你面板里显示哪些项。
                                         用按钮 + 弹窗，而不是把勾选列表直接铺在卡片里：
                                         项数不确定（DC 项 + HDR/分辨率/刷新率/缩放），
                                         平铺会把卡片撑得很长，把下面的亮度范围挤走。 -->
                                    <tk:SettingsCard Header="迷你面板控制项"
                                                     Description="选择这台显示器在迷你面板里显示哪些项。">
                                        <Button Content="配置…"
                                                Click="OnConfigureMiniControls"
                                                Tag="{x:Bind Id}" />
                                    </tk:SettingsCard>

                                    <tk:SettingsCard Header="亮度范围">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <!-- 用 Inline 而不是 Compact：Compact 的增减箭头
                                                 平时隐藏、聚焦时才弹出一个浮层，这个浮层会盖住
                                                 下面的内容，看起来像是"点了上面的按钮却触发了
                                                 下面的输入"。Inline 把箭头常驻在框内右侧，
                                                 不占额外空间、也不会遮挡。 -->
                                            <NumberBox Value="{x:Bind RangeLow, Mode=TwoWay}"
                                                       Minimum="0"
                                                       Maximum="100"
                                                       SpinButtonPlacementMode="Inline"
                                                       Width="130"
                                                       SmallChange="1"
                                                       Header="最低" />
                                            <NumberBox Value="{x:Bind RangeHigh, Mode=TwoWay}"
                                                       Minimum="0"
                                                       Maximum="100"
                                                       SpinButtonPlacementMode="Inline"
                                                       Width="130"
                                                       SmallChange="1"
                                                       Header="最高" />
                                            <Button Content="重置"
                                                    VerticalAlignment="Bottom"
                                                    Click="OnResetRange"
                                                    Tag="{x:Bind Id}" />
                                        </StackPanel>
                                    </tk:SettingsCard>
                                </tk:SettingsExpander.Items>
                            </tk:SettingsExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <tk:SettingsCard x:Name="EmptyCard"
                                 Header="未检测到显示器"

                                 Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>





