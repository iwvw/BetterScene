<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BetterScene.App.Pages.ScenesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BetterScene.App.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    Style="{StaticResource PageRootStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="场景">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="预览浅色" Click="OnApplyLight" />
                    <Button Content="预览深色" Style="{StaticResource AccentButtonStyle}" Click="OnApplyDark" />
                </StackPanel>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <ScrollViewer Grid.Row="1"
                      Padding="36,0,36,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      HorizontalContentAlignment="Stretch">
            <StackPanel Padding="0,0,0,24" Spacing="{StaticResource SettingsCardSpacing}" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="50" />
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <tk:SettingsCard Header="使用主题文件">                    <ToggleSwitch x:Name="UseThemeFileSwitch" Toggled="OnUseThemeFileToggled" />
                </tk:SettingsCard>

                <tk:SettingsExpander Header="浅色场景" >
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE706;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="主题文件" >
                            <Grid ColumnSpacing="6" MinWidth="220" MaxWidth="380">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="LightThemeBox"
                                          Grid.Column="0"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnLightThemeChanged" />
                                <Button Grid.Column="1"
                                        Width="34"
                                        Height="32"
                                        Padding="0"
                                        Click="OnRefreshThemes"
                                        ToolTipService.ToolTip="刷新主题列表">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                            </Grid>
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="壁纸">
                            <Grid ColumnSpacing="6" MinWidth="220" MaxWidth="380">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LightWallpaperText"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="未设置" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                    <Button Width="34"
                                            Height="32"
                                            Padding="0"
                                            Click="OnPickLight"
                                            ToolTipService.ToolTip="选择壁纸">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                    </Button>
                                    <Button Width="34"
                                            Height="32"
                                            Padding="0"
                                            Click="OnClearLight"
                                            ToolTipService.ToolTip="清除壁纸">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <tk:SettingsExpander Header="深色场景" >
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE708;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="主题文件" >
                            <Grid ColumnSpacing="6" MinWidth="220" MaxWidth="380">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="DarkThemeBox"
                                          Grid.Column="0"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnDarkThemeChanged" />
                                <Button Grid.Column="1"
                                        Width="34"
                                        Height="32"
                                        Padding="0"
                                        Click="OnRefreshThemes"
                                        ToolTipService.ToolTip="刷新主题列表">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                            </Grid>
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="壁纸">
                            <Grid ColumnSpacing="6" MinWidth="220" MaxWidth="380">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DarkWallpaperText"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="未设置" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                    <Button Width="34"
                                            Height="32"
                                            Padding="0"
                                            Click="OnPickDark"
                                            ToolTipService.ToolTip="选择壁纸">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                    </Button>
                                    <Button Width="34"
                                            Height="32"
                                            Padding="0"
                                            Click="OnClearDark"
                                            ToolTipService.ToolTip="清除壁纸">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>





