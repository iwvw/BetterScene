<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">

    <tb:TaskbarIcon x:Key="BetterSceneTrayIcon"
                    IconSource="ms-appx:///Assets/TrayWhite.ico"
                    NoLeftClickDelay="True"
                    ToolTipText="Windows 视觉改善"
                    Visibility="Collapsed">
        <tb:TaskbarIcon.ContextFlyout>
            <MenuFlyout AreOpenCloseAnimationsEnabled="True">
                <MenuFlyoutItem x:Name="TrayStatusItem" FontSize="13" IsEnabled="False" Text="状态：加载中">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontSize="12" Glyph="&#xE9D9;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="TrayOpenItem" Text="打开主界面">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontSize="14" Glyph="&#xE80F;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="TrayPanelItem" Text="显示面板">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontSize="14" Glyph="&#xE7F4;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="TrayThemeMenu" Text="切换主题">
                    <MenuFlyoutSubItem.Icon>
                        <FontIcon FontSize="14" Glyph="&#xE790;" />
                    </MenuFlyoutSubItem.Icon>
                    <ToggleMenuFlyoutItem x:Name="TrayLightItem" Text="浅色">
                        <ToggleMenuFlyoutItem.Icon>
                            <FontIcon FontSize="14" Glyph="&#xE706;" />
                        </ToggleMenuFlyoutItem.Icon>
                    </ToggleMenuFlyoutItem>
                    <ToggleMenuFlyoutItem x:Name="TrayDarkItem" Text="深色">
                        <ToggleMenuFlyoutItem.Icon>
                            <FontIcon FontSize="14" Glyph="&#xE708;" />
                        </ToggleMenuFlyoutItem.Icon>
                    </ToggleMenuFlyoutItem>
                </MenuFlyoutSubItem>
                <MenuFlyoutItem x:Name="TrayToggleItem" Text="切换明暗">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontSize="14" Glyph="&#xE793;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="TrayPauseItem" Text="暂停自动切换">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontSize="14" Glyph="&#xE769;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="TraySettingsItem" Text="设置">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontSize="14" Glyph="&#xE713;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="TrayExitItem" Text="退出">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontSize="14" Glyph="&#xE7E8;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </tb:TaskbarIcon.ContextFlyout>
    </tb:TaskbarIcon>

</ResourceDictionary>
