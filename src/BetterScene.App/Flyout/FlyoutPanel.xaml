<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BetterScene.App.Flyout.FlyoutPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:BetterScene.App.Services"
    xmlns:controls="using:BetterScene.App.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 全局唯一的一套间距：四边距、卡片之间、卡片与底栏、底栏按钮之间，
                 全部用这同一个值，视觉上才会真正等距。 -->
            <x:Double x:Key="PanelGap">10</x:Double>
            <Thickness x:Key="PanelPadding">10</Thickness>

            <!-- 卡片内部留白。必须小于 PanelGap，
                 否则卡片内部看起来比卡片之间更松，视觉上就"不等距"了。 -->
            <Thickness x:Key="CardPadding">12,8,12,8</Thickness>

            <Style x:Key="MiniModeButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="MiniIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
            </Style>
            <Style x:Key="MiniLinkButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- VerticalAlignment=Bottom：内容贴着窗口底边排布。
         窗口是按「底边固定、向上长高」定位的，内容底部对齐后，
         底部控制栏在展开/收起过程中始终停在原位，不会跟着跳。 -->
    <Grid x:Name="RootGrid" MinWidth="320"
          Padding="{StaticResource PanelPadding}"
          RowSpacing="{StaticResource PanelGap}"
          VerticalAlignment="Bottom" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="SolidBackdrop"
                Grid.RowSpan="2"
                Margin="-12"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                Visibility="Collapsed" />

        <!-- 控制按钮放在底部：面板贴着任务栏弹出，底部是拇指/鼠标最容易够到的位置。 -->
        <Grid Grid.Row="1" x:Name="BottomBar" ColumnSpacing="{StaticResource PanelGap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ToggleButton x:Name="LightButton" Grid.Column="0"
                          Style="{StaticResource MiniModeButtonStyle}"
                          Content="浅色" Click="OnLightClick" />
            <ToggleButton x:Name="AutoButton" Grid.Column="1"
                          Style="{StaticResource MiniModeButtonStyle}"
                          ToolTipService.ToolTip="自动切换场景"
                          Content="自动" Click="OnAutoClick">
                <ToggleButton.ContextFlyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <ToggleMenuFlyoutItem x:Name="FollowSystemItem"
                                              Text="跟随系统明暗"
                                              Click="OnFollowSystemClick" />
                        <ToggleMenuFlyoutItem x:Name="ScheduleItem"
                                              Text="按时间规则"
                                              Click="OnScheduleClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="EditRulesItem"
                                        Text="编辑规则…"
                                        Click="OnEditRulesClick" />
                    </MenuFlyout>
                </ToggleButton.ContextFlyout>
            </ToggleButton>
            <ToggleButton x:Name="DarkButton" Grid.Column="2"
                          Style="{StaticResource MiniModeButtonStyle}"
                          Content="深色" Click="OnDarkClick" />
            <ToggleButton x:Name="LinkButton" Grid.Column="3"
                          Style="{StaticResource MiniLinkButtonStyle}"
                          services:GhostHover.Enabled="True"
                          ToolTipService.ToolTip="关联所有显示器，亮度同步调节"
                          Click="OnLinkClick">
                <FontIcon FontSize="12" Glyph="&#xE71B;" />
            </ToggleButton>
            <Button Grid.Column="4"
                    Style="{StaticResource MiniIconButtonStyle}"
                    services:GhostHover.Enabled="True"
                    ToolTipService.ToolTip="设置"
                    Click="OnSettingsClick">
                <FontIcon FontSize="12" Glyph="&#xE713;" />
            </Button>
            <Button Grid.Column="5"
                    Style="{StaticResource MiniIconButtonStyle}"
                    services:GhostHover.Enabled="True"
                    ToolTipService.ToolTip="收起"
                    Click="OnCollapseClick">
                <FontIcon FontSize="12" Glyph="&#xE70D;" />
            </Button>
        </Grid>

        <!-- 不设 MaxHeight：面板一次性展示全部内容，不出现滚动条。
             高度由 DisplayList.DesiredSize 决定，窗口跟着长高。 -->
        <ScrollViewer Grid.Row="0"
                      x:Name="DisplayScroll"
                      VerticalAlignment="Top"
                      VerticalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled">
            <ItemsControl x:Name="DisplayList"
                          VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:SpacedStackPanel Spacing="{StaticResource PanelGap}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <!-- 这里只保留横向拉伸。
                     不能放 ScaleY / Opacity：那是入场动画的起始状态，
                     如果常驻在 Style 里，卡片会被永久压扁 14% 并垂直居中，
                     首尾两端就会多出几像素空隙，看起来"顶部间距大于左右"。 -->
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="services:DisplaySliderItem">
                        <Border Padding="{StaticResource CardPadding}"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind CardVisibility, Mode=OneWay}">
                            <controls:SpacedStackPanel Spacing="6">

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              FontSize="14"
                                              Glyph="{x:Bind Icon, Mode=OneWay}" />

                                    <!-- 迷你面板只有一行标题，用带品牌的 DisplayTitle；
                                         显示器页那种品牌/型号双行布局才用 Title。 -->
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind DisplayTitle, Mode=OneWay}" />

                                    <!-- 尺寸靠右。取不到 EDID 物理尺寸时整列隐藏。 -->
                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind SizeVisibility, Mode=OneWay}"
                                               Text="{x:Bind SizeText, Mode=OneWay}" />
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0"
                                              VerticalAlignment="Center"
                                              FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Glyph="&#xE706;" />

                                    <Slider Grid.Column="1"
                                            Margin="0,0,0,0"
                                            MinWidth="0"
                                            VerticalAlignment="Center"
                                            Minimum="0"
                                            Maximum="100"
                                            StepFrequency="1"
                                            ManipulationMode="None"
                                            services:SliderWheel.Step="5"
                                            Value="{x:Bind Level, Mode=TwoWay}"
                                            IsEnabled="{x:Bind CanControl, Mode=OneWay}" />

                                    <TextBlock Grid.Column="2"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="亮度" />
                                </Grid>

                                <ItemsControl ItemsSource="{x:Bind MiniSliders}"
                                              Visibility="{x:Bind MiniSlidersVisibility, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:SpacedStackPanel Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="controls:ControlRow">
                                            <controls:ControlRowView Row="{x:Bind}"
                                                                     Loaded="OnControlRowViewLoaded" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 分辨率 -->
                                <Grid ColumnSpacing="8"
                                      Visibility="{x:Bind MiniResolutionVisibility, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0"
                                              VerticalAlignment="Center"
                                              FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Glyph="&#xE7F8;" />

                                    <ComboBox Grid.Column="1"
                                              HorizontalAlignment="Stretch"
                                              MinHeight="0"
                                              Padding="8,3"
                                              ItemsSource="{x:Bind ResolutionLabels, Mode=OneWay}"
                                              SelectedIndex="{x:Bind ResolutionIndex, Mode=OneWay}"
                                              SelectionChanged="OnMiniResolutionChanged"
                                              Tag="{x:Bind Id}" />

                                    <TextBlock Grid.Column="2"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="分辨率" />
                                </Grid>

                                <!-- 刷新率 -->
                                <Grid ColumnSpacing="8"
                                      Visibility="{x:Bind MiniRefreshRateVisibility, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0"
                                              VerticalAlignment="Center"
                                              FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Glyph="&#xE916;" />

                                    <ComboBox Grid.Column="1"
                                              HorizontalAlignment="Stretch"
                                              MinHeight="0"
                                              Padding="8,3"
                                              ItemsSource="{x:Bind RefreshRateLabels, Mode=OneWay}"
                                              SelectedIndex="{x:Bind RefreshRateIndex, Mode=OneWay}"
                                              SelectionChanged="OnMiniRefreshRateChanged"
                                              Tag="{x:Bind Id}" />

                                    <TextBlock Grid.Column="2"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="刷新率" />
                                </Grid>

                                <!-- 缩放 -->
                                <Grid ColumnSpacing="8"
                                      Visibility="{x:Bind MiniScaleVisibility, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0"
                                              VerticalAlignment="Center"
                                              FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Glyph="&#xE9A6;" />

                                    <ComboBox Grid.Column="1"
                                              HorizontalAlignment="Stretch"
                                              MinHeight="0"
                                              Padding="8,3"
                                              ItemsSource="{x:Bind ScaleLabels, Mode=OneWay}"
                                              SelectedIndex="{x:Bind ScaleIndex, Mode=OneWay}"
                                              SelectionChanged="OnMiniScaleChanged"
                                              Tag="{x:Bind Id}" />

                                    <TextBlock Grid.Column="2"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="缩放" />
                                </Grid>

                                <ItemsControl ItemsSource="{x:Bind MiniChoices}"
                                              Visibility="{x:Bind MiniChoicesVisibility, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:SpacedStackPanel Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="controls:ControlRow">
                                            <controls:ControlRowView Row="{x:Bind}"
                                                                     Loaded="OnControlRowViewLoaded" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- HDR。不支持的显示器整行隐藏。
                                     用 ToggleButton 而不是 ToggleSwitch：面板里行高紧张，
                                     开关控件自带的内边距会把一行撑得比其它行高。 -->
                                <Grid ColumnSpacing="8"
                                      Visibility="{x:Bind MiniHdrVisibility, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0"
                                              VerticalAlignment="Center"
                                              FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Glyph="&#xE7F4;" />

                                    <ToggleButton Grid.Column="1"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Center"
                                                  MinHeight="0"
                                                  Padding="8,3"
                                                  CornerRadius="4"
                                                  IsChecked="{x:Bind HdrEnabled, Mode=OneWay}"
                                                  IsEnabled="{x:Bind HdrToggleEnabled, Mode=OneWay}"
                                                  Click="OnMiniHdrClick"
                                                  Tag="{x:Bind Id}"
                                                  Content="HDR" />

                                    <TextBlock Grid.Column="2"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="HDR" />
                                </Grid>

                                <ItemsControl ItemsSource="{x:Bind MiniActions}"
                                              Visibility="{x:Bind MiniActionsVisibility, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:SpacedStackPanel Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="controls:ControlRow">
                                            <controls:ControlRowView Row="{x:Bind}"
                                                                     Loaded="OnControlRowViewLoaded" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </controls:SpacedStackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="EmptyHint"
                   Grid.Row="0"
                   Margin="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="未检测到显示器"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
